# Copy to `.env` (repo root or backend/) — loaded automatically at startup.

# Secret for signing JWT auth tokens. REQUIRED in production.
# Generate one:  openssl rand -hex 32
# JWT_SECRET=replace-with-64-hex-chars

# Database. Omit for SQLite (backend/istrominventory.db, auto-created).
# For PostgreSQL (production):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/istrom

# Allowed browser origins for the frontend (comma-separated). REQUIRED in
# production so the deployed frontend can call the API. Never use "*".
# CORS_ORIGINS=https://inventory.istrom.com

# Expose interactive API docs at /docs and /redoc. Leave unset in production.
# ENABLE_DOCS=true

# Web Push (phone notifications while the app is closed). Optional — the app
# runs without it. Generate keys once:
#   python -c "from py_vapid import Vapid,b64urlencode; from cryptography.hazmat.primitives import serialization; v=Vapid(); v.generate_keys(); print('VAPID_PRIVATE_KEY='+b64urlencode(v.private_key.private_numbers().private_value.to_bytes(32,'big'))); print('VAPID_PUBLIC_KEY='+b64urlencode(v.public_key.public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)))"
# VAPID_PRIVATE_KEY=...
# VAPID_PUBLIC_KEY=...
# VAPID_SUBJECT=mailto:you@example.com
