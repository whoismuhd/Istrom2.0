# Copy to `.env` (repo root or backend/) — loaded automatically at startup.

# Secret for signing JWT auth tokens. REQUIRED in production.
# Generate one:  openssl rand -hex 32
# JWT_SECRET=replace-with-64-hex-chars

# Database. Omit for SQLite (backend/istrominventory.db, auto-created).
# For PostgreSQL (production):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/istrom
