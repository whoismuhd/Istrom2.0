# Copy to `.env` (repo root or backend/) — loaded automatically at startup.

# Secret for signing JWT auth tokens. REQUIRED locally and in production.
# Generate one:  openssl rand -hex 32
# JWT_SECRET=replace-with-64-hex-chars

# Required only when initializing a NEW database: a private setup code used
# once to create the first named administrator. Existing installations keep
# their current administrator code for this one-time setup.
# Generate a private value: openssl rand -hex 24
# INITIAL_ADMIN_CODE=...

# ACCESS_CODE_ENCRYPTION_KEY may be retained when upgrading an installation
# with encrypted legacy site codes. Those codes no longer grant login access.

# Database. Omit for SQLite (backend/istrominventory.db, auto-created).
# For PostgreSQL (production):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/istrom

# Allowed browser origins for the frontend (comma-separated). REQUIRED in
# production so the deployed frontend can call the API. Never use "*".
# CORS_ORIGINS=https://inventory.istromgroup.com.ng

# Frontend BUILD setting, configured on the static-site host. Use the API's
# HTTPS origin without a trailing slash. This value is public, not a secret.
# VITE_API_URL=https://YOUR-API.onrender.com

# Expose interactive API docs at /docs and /redoc. Leave unset in production.
# ENABLE_DOCS=true

# Admin password recovery. All settings belong on the BACKEND only.
# The recipient is fixed here; visitors cannot enter a different email.
# ADMIN_RECOVERY_EMAIL=admin@example.com
# APP_FRONTEND_URL=https://inventory.istromgroup.com.ng
# Resend's HTTPS API works on Render Free, which blocks normal SMTP ports.
# ADMIN_RECOVERY_PROVIDER=resend
# RESEND_API_KEY=...
# RESEND_FROM=onboarding@resend.dev
# With onboarding@resend.dev, the recipient must be your Resend account email.
# Verify a company sender domain in Resend before sending to other addresses.
# Optional SMTP transport for hosts that permit outbound SMTP:
# ADMIN_RECOVERY_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=admin@example.com
# SMTP_PASSWORD=...
# SMTP_FROM=admin@example.com
# SMTP_SECURITY=ssl can be used with port 465. Plaintext SMTP is not supported.

# Web Push (phone notifications while the app is closed). Optional — the app
# runs without it. Generate keys once:
#   python -c "from py_vapid import Vapid,b64urlencode; from cryptography.hazmat.primitives import serialization; v=Vapid(); v.generate_keys(); print('VAPID_PRIVATE_KEY='+b64urlencode(v.private_key.private_numbers().private_value.to_bytes(32,'big'))); print('VAPID_PUBLIC_KEY='+b64urlencode(v.public_key.public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)))"
# VAPID_PRIVATE_KEY=...
# VAPID_PUBLIC_KEY=...
# VAPID_SUBJECT=mailto:you@example.com
