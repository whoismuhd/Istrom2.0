{
  "name": "istrom-inventory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && python -m uvicorn api.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "install:all": "pip install -r backend/requirements.txt && cd frontend && npm install",
    "init-db": "cd backend && python schema_init.py"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
